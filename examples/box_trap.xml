<!-- 흔한 실수 네 가지가 들어간 MuJoCo 장면 -->
<mujoco model="box_trap">
  <option timestep="0.004"/>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 1"/>                  <!-- friction 기본값 1.0 -->
    <body name="crate" pos="0 0 0.1">
      <freejoint/>
      <geom name="crate" type="box" size="0.05 0.05 0.1" mass="1"
            friction="0.5 0.005 0.0001" solref="0.01 1"/>           <!-- μ=0.5 를 원했음 -->
    </body>
  </worldbody>
</mujoco>
